{% set outOfStock = getConfig('config.products.out-of-stock') == '1' %}
{% set isOos = outOfStock and not product.saleable %}

<div class="product-box">
    <div class="product-card{{ isOos ? ' oos' : '' }}">

        {% if product['new'] %}
            <div class="sticker new">{{ ('shop::app.products.new'|trans) }}</div>
        {% endif %}

        <a href="/{{ product.url_key }}" title="{{ product.name }}" class="product-a">
            <div class="product-image">
                {% if isOos %}
                    <div class="oos-badge"><span>{{ ('shop::app.products.out_of_stock'|trans) }}</span></div>
                {% endif %}
                <img src="{{ product.product.base_image_url }}" alt="{{ product.name }}" loading="lazy">
                {% if product['promotion_title'] %}
                    <div class="card-promo">{{ product['promotion_title'] }}</div>
                {% endif %}
            </div>
            <div class="product-information">
                <div class="product-name">{{ product.name }}</div>
            </div>
        </a>

        <div class="product-bottom-row">
            {{ product.html_price | raw }}

            <span class="cart-wish-wrap">
                {% include 'products/wishlist.twig' %}

                <form id="addToCart-{{ product.product_id }}">
                    <input type="hidden" name="_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="product_id" value="{{ product.product_id }}">
                    <input type="hidden" name="quantity" value="1">
                    {% if isOos %}
                        <span class="not-available">{{ ('shop::app.products.out_of_stock'|trans) }}</span>
                    {% else %}
                        <button type="button" class="btn addToCart border-0" data-id="{{ product.product_id }}">🛒</button>
                    {% endif %}
                </form>
            </span>
        </div>

    </div>
</div>
