{# نفس "قائمة العناصر" لكن بشكل سلايدر أفقي (type=slider من لوحة التحكم) #}
<div class="theme-section" {{ content['settings']['title'] ? '' : 'style="padding-top:0;"' }}>
    {% if content['settings']['title'] %}
        <div class="theme-section-head"><h2>{{ content['settings']['title'] }}</h2></div>
    {% endif %}
    <div class="scrollrow" id="block{{ content['block_id'] }}">
        {% for item in content['settings']['items'] %}
            <a class="cat-card" style="min-width:180px;flex-shrink:0;" href="{{ item['link'] ?? '#' }}">
                <img src="{{ item['image'] }}" alt="{{ item['name'] }}">
                {% if item['name'] %}
                    <div class="ov"><span>{{ item['name'] }}</span></div>
                {% endif %}
            </a>
        {% endfor %}
    </div>
</div>
